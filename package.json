{
  "name": "adaptive-donchian-screener",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:server": "next build && next start --hostname 127.0.0.1 --port 3197",
    "test:e2e:stability": "playwright test --repeat-each=5",
    "release:check": "npm test && npm run lint && npm run typecheck && npm run test:e2e && npm run build"
  },
  "dependencies": {
    "next": "16.3.0",
    "papaparse": "^5.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "yahoo-finance2": "^4.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "24.10.1",
    "@types/papaparse": "^5.5.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.1",
    "eslint-config-next": "16.3.0",
    "jsdom": "^30.0.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
